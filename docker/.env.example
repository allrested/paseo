# Copy to .env and edit. Every value below has a working default in
# docker-compose.yml, so an unmodified local checkout still runs with no .env
# at all. On Dokploy, set these in the app's Environment tab instead.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Instance identity
# ---------------------------------------------------------------------------
# Prefix for container names. MUST be unique per instance on a shared host —
# Docker container names are global, so two instances with the same prefix will
# refuse to start.
INSTANCE_NAME=paseo

# Tag for the locally built agent image. Instances sharing a tag share the
# image, which is usually what you want; give it a distinct value only when an
# instance needs different agent tooling.
AGENT_IMAGE=paseo-with-agents:latest

# Paseo base image the agent image is built FROM. `paseo:src` is built from
# this repo (see Dockerfile.agents); switch to ghcr.io/getpaseo/paseo:latest to
# use the published build, which drops the Kiro usage card.
PASEO_IMAGE=paseo:src

# ---------------------------------------------------------------------------
# Ports — must be unique per instance on a shared host
# ---------------------------------------------------------------------------
# Which host interface the ports below are published on. The default reaches
# the UI at http://localhost:6767 on a plain local run. Set it to 127.0.0.1
# when a reverse proxy serves these containers over TLS (the proxy reaches them
# over dokploy-network, not through a published port) — otherwise the daemon
# and the browser stay reachable in cleartext on the public interface, guarded
# only by PASEO_PASSWORD and BROWSER_PASSWORD.
BIND_ADDRESS=0.0.0.0
PASEO_PORT=6767
# Your dev server, as seen from outside. The app still listens on
# DEV_PORT_INTERNAL inside the container.
DEV_PORT=6666
DEV_PORT_INTERNAL=3000
# The browser's screen (noVNC).
BROWSER_PORT=3000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Per-user. Daemon state, agent credentials, MCP config. Never share this
# between instances — two daemons writing one state directory will corrupt it.
PASEO_HOME_DIR=./paseo-home

# Shared between instances is supported and intended. See the shared-workspace
# note in docker-compose.yml before pointing several instances at one path.
WORKSPACE_DIR=./workspace

# Per-user. Chromium profile: cookies, logins, solved captchas.
BROWSER_CONFIG_DIR=./browser-config

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Required for anything reachable off localhost. Change it.
PASEO_PASSWORD=change-me

# Comma-separated DNS names you reach Paseo by. IPs and localhost are allowed
# by default; a domain is not, and the daemon will reject it without this.
PASEO_HOSTNAMES=

# noVNC has NO authentication unless you set both of these. Anyone who reaches
# BROWSER_PORT can drive a browser holding your logged-in sessions. Set them
# for any deployment that is not localhost-only.
BROWSER_USER=
BROWSER_PASSWORD=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=Asia/Jakarta

# Ownership for the browser container's files. Leave at 1000 when WORKSPACE_DIR
# is shared: the paseo image's user is uid 1000 and cannot be changed, so a
# different PUID here makes the two containers fight over ownership.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Git identity — who commits are attributed to
# ---------------------------------------------------------------------------
# Not the same thing as `gh auth login`, which only decides who pushes. Leave
# these empty and git refuses to commit ("Please tell me who you are"), or
# attributes the work to nobody. Set them per instance.
# GIT_COMMITTER_* default to the GIT_AUTHOR_* values; set them only if you want
# committer and author to differ.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ---------------------------------------------------------------------------
# Agent secrets
# ---------------------------------------------------------------------------
# Inherited by every agent and terminal Paseo launches.
BDDEVLAB_API_KEY=

# Add provider keys the same way, then reference them in docker-compose.yml.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
