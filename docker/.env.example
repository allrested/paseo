# Copy to .env and edit. Every value below has a working default in
# docker-compose.yml, so an unmodified local checkout still runs with no .env
# at all. On Dokploy, set these in the app's Environment tab instead.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Instance identity
# ---------------------------------------------------------------------------
# Prefix for container names. MUST be unique per instance on a shared host —
# Docker container names are global, so two instances with the same prefix will
# refuse to start.
INSTANCE_NAME=paseo

# The agent image to run. Published by .github/workflows/docker.yml; compose
# pulls it and never builds, so a deploy takes seconds. Pin an exact version
# (e.g. ghcr.io/allrested/paseo-agents:0.5.1) when you want a deploy to be
# reproducible rather than tracking the newest publish. Point it at a local
# tag to run an image you built yourself.
AGENT_IMAGE=ghcr.io/allrested/paseo-agents:latest

# Only used when building the agent image by hand — the base it is layered
# FROM. CI passes the version-pinned base it just published, so this is
# ignored on a normal pull-based deploy. Must be a build of THIS fork:
# ghcr.io/getpaseo/paseo has neither the BDDevLab usage provider nor the Kiro
# usage fetcher, which live in packages/server.
PASEO_IMAGE=ghcr.io/allrested/paseo:latest

# ---------------------------------------------------------------------------
# Ports — must be unique per instance on a shared host
# ---------------------------------------------------------------------------
# Which host interface the ports below are published on. The default reaches
# the UI at http://localhost:6767 on a plain local run. Set it to 127.0.0.1
# when a reverse proxy serves these containers over TLS (the proxy reaches them
# over dokploy-network, not through a published port) — otherwise the daemon
# and the browser stay reachable in cleartext on the public interface, guarded
# only by PASEO_PASSWORD and BROWSER_PASSWORD.
BIND_ADDRESS=0.0.0.0
PASEO_PORT=6767
# Your dev server, as seen from outside. The app still listens on
# DEV_PORT_INTERNAL inside the container.
DEV_PORT=6666
DEV_PORT_INTERNAL=3000
# The browser's screen (noVNC).
BROWSER_PORT=3000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Per-user. Daemon state, agent credentials, MCP config. Never share this
# between instances — two daemons writing one state directory will corrupt it.
PASEO_HOME_DIR=./paseo-home

# Shared between instances is supported and intended. See the shared-workspace
# note in docker-compose.yml before pointing several instances at one path.
WORKSPACE_DIR=./workspace

# Per-user. Chromium profile: cookies, logins, solved captchas.
BROWSER_CONFIG_DIR=./browser-config

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Required for anything reachable off localhost. Change it.
PASEO_PASSWORD=change-me

# Comma-separated DNS names you reach Paseo by. IPs and localhost are allowed
# by default; a domain is not, and the daemon will reject it without this.
PASEO_HOSTNAMES=

# noVNC has NO authentication unless you set both of these. Anyone who reaches
# BROWSER_PORT can drive a browser holding your logged-in sessions. Set them
# for any deployment that is not localhost-only.
BROWSER_USER=
BROWSER_PASSWORD=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=Asia/Jakarta

# Ownership for the browser container's files. Leave at 1000 when WORKSPACE_DIR
# is shared: the paseo image's user is uid 1000 and cannot be changed, so a
# different PUID here makes the two containers fight over ownership.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Git identity — who commits are attributed to
# ---------------------------------------------------------------------------
# Not the same thing as `gh auth login`, which only decides who pushes. Set
# them per instance: they are what attributes this container's commits to its
# own operator when several containers share a workspace. Left empty, the
# entrypoint drops them and git falls back to whatever ~/.gitconfig says.
# GIT_COMMITTER_* default to the GIT_AUTHOR_* values; set them only if you want
# committer and author to differ.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ---------------------------------------------------------------------------
# Agent secrets
# ---------------------------------------------------------------------------
# Inherited by every agent and terminal Paseo launches.
BDDEVLAB_API_KEY=

# Add provider keys the same way, then reference them in docker-compose.yml.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Private network access (optional)
# ---------------------------------------------------------------------------
# Only used by the VPN stack, docker-compose.vpn.yml:
#   docker compose -f docker-compose.vpn.yml up -d
#
# Requires ppp_generic on the host:
#   modprobe ppp_generic && echo ppp_generic > /etc/modules-load.d/ppp.conf

VPN_IMAGE=ghcr.io/allrested/paseo-vpn:latest

# FortiGate SSL-VPN gateway.
VPN_GATEWAY=vpn.example.com
VPN_PORT=443
VPN_USERNAME=
VPN_PASSWORD=

# Gateway certificate SHA256. Leave empty on the first connect: the client
# refuses the unknown certificate and prints the digest to paste here. Pinning
# it is what prevents a machine-in-the-middle.
VPN_TRUSTED_CERT=

# Set only if the portal is realm-scoped. A missing realm fails authentication
# in a way that looks like a wrong password.
VPN_REALM=

# Base64 of a PEM CA certificate, set only when something between the container
# and the gateway terminates and re-signs TLS — a ZTNA or inspecting proxy. The
# client then sees a certificate signed by a root the image does not trust,
# refuses the connection, and never reaches PPP, which looks the same as a wrong
# password. Encode with:
#   base64 -w0 your-ca.crt
VPN_CA_CERT_B64=

# What "internal" means, comma-separated. Curate this by hand — a gateway
# offers far more, including public address space, and installing that would
# route parts of the internet through the tunnel. Validated at startup: RFC
# 1918 only, /12 or longer, no overlap with the container's own networks. The
# range must not overlap dokploy-network either — Dokploy's Swarm overlay
# pool defaults to 10.0.0.0/8, so a range like 10.0.0.0/16 can collide with
# the reverse-proxy network paseo is already on.
INTERNAL_CIDRS=10.42.0.0/16

# The narrow exception to the rule above: specific PUBLIC destinations that must
# be reached from the corporate network's egress address, because the far end
# allowlists it — an internal AI gateway or a SaaS endpoint locked to the office
# IP. Comma-separated, and per HOST rather than per network: validated as /24 or
# longer, outside RFC 1918 (private ranges belong in INTERNAL_CIDRS) and outside
# special-use space such as loopback and the link-local block cloud metadata
# services live on. Everything undeclared still leaves the container directly, so the
# tunnel never becomes a default route. Leave empty unless something needs it.
EXTERNAL_VIA_VPN=

# host:port the gateway healthcheck connects to through the tunnel.
VPN_HEALTH_TARGET=git.internal.example.com:22

# Git over SSH to the private server.
INTERNAL_SSH_HOST=git.internal.example.com
# A path inside the container, not on the host. Place the key on the host at
# ${PASEO_HOME_DIR}/.ssh/internal_key — that directory is already mounted to
# /home/paseo, so no separate mount is needed. chown 1000:1000 and chmod 600
# it: uid 1000 is the paseo user, and OpenSSH refuses a group-readable
# private key.
INTERNAL_SSH_KEY_FILE=/home/paseo/.ssh/internal_key
# From `ssh-keyscan <host>` run while the tunnel is up. Separate entries with
# \n — .env parsing across compose versions does not carry real newlines.
SSH_KNOWN_HOSTS_EXTRA=
