#!/usr/bin/env bash
# Run by pppd when the tunnel comes up. Installs exactly the declared CIDRs and
# no default route, so the container keeps its own path to the internet — which
# the client's TLS connection to the gateway depends on.
#
# pppd runs scripts in this directory with its own restricted environment,
# which does not guarantee INTERNAL_CIDRS survives from the parent process. If
# it is missing here, fall back to the file paseo-vpn-entrypoint persisted it
# to before starting the client. An explicit, non-empty INTERNAL_CIDRS in the
# environment always wins.
set -euo pipefail

if [ -z "${INTERNAL_CIDRS:-}" ]; then
  env_file=${PASEO_VPN_ENV_FILE:-/etc/paseo-vpn.env}
  if [ -f "$env_file" ]; then
    # shellcheck disable=SC1090
    source "$env_file"
  fi
fi

[ -n "${INTERNAL_CIDRS:-}" ] || {
  printf 'paseo-vpn: INTERNAL_CIDRS is required\n' >&2
  exit 1
}

read -r -a cidrs <<<"${INTERNAL_CIDRS//,/ }"
for cidr in "${cidrs[@]}"; do
  if [ -n "${PASEO_VPN_DRY_RUN:-}" ]; then
    printf 'ip route replace %s dev ppp0\n' "$cidr"
  else
    ip route replace "$cidr" dev ppp0
  fi
done
