# syntax=docker/dockerfile:1
# The FigCraft design stack for design mode: figcraft-server and the figcraft-web browser build
# behind Caddy, in one container. FigCraft is alpha, so one release is pinned and checked against
# its SHA256SUMS.txt; upgrade it in step with docker/Dockerfile.agents and
# plugins/design/test/install-figcraft.sh (see docs/docker.md).
ARG CADDY_IMAGE=caddy:2
FROM ${CADDY_IMAGE} AS caddy

FROM debian:bookworm-slim

# Links the published package to its repository on GHCR. Defaults to upstream so
# forks stay mergeable; CI overrides it per repository via --build-arg.
ARG IMAGE_SOURCE=https://github.com/getpaseo/paseo
LABEL org.opencontainers.image.source="${IMAGE_SOURCE}"

ARG FIGCRAFT_VERSION=0.18.1
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl unzip; \
    base="https://github.com/storytold/figcraft/releases/download/v${FIGCRAFT_VERSION}"; \
    server="figcraft-server-${FIGCRAFT_VERSION}-linux-${arch}.tar.gz"; \
    web="figcraft-web-${FIGCRAFT_VERSION}.zip"; \
    mkdir /tmp/figcraft; \
    cd /tmp/figcraft; \
    curl -fsSL -o SHA256SUMS.txt "${base}/SHA256SUMS.txt"; \
    curl -fsSL -o "${server}" "${base}/${server}"; \
    curl -fsSL -o "${web}" "${base}/${web}"; \
    grep -E " (${server}|${web})\$" SHA256SUMS.txt > wanted.txt; \
    test "$(wc -l < wanted.txt)" -eq 2; \
    sha256sum -c wanted.txt; \
    tar -xzf "${server}"; \
    install -m 0755 "figcraft-server-${FIGCRAFT_VERSION}-linux-${arch}/figcraft-server" \
      /usr/local/bin/figcraft-server; \
    unzip -q "${web}"; \
    mkdir -p /srv; \
    mv "figcraft-web-${FIGCRAFT_VERSION}" /srv/figcraft-web; \
    cp /srv/figcraft-web/index.html /srv/figcraft-web/index.html.orig; \
    cd /; \
    rm -rf /tmp/figcraft; \
    apt-get purge -y --auto-remove curl unzip; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin figcraft; \
    mkdir -p /data; \
    chown figcraft /data /srv/figcraft-web/index.html

COPY --from=caddy /usr/bin/caddy /usr/local/bin/caddy
COPY figcraft/server.toml /etc/figcraft/server.toml
COPY figcraft/Caddyfile /etc/caddy/Caddyfile
COPY --chmod=0755 figcraft/entrypoint.sh /usr/local/bin/figcraft-entrypoint

# Caddy keeps its state under XDG dirs; with admin and automatic HTTPS off there is little.
ENV XDG_DATA_HOME=/data/caddy XDG_CONFIG_HOME=/tmp/caddy-config
USER figcraft
VOLUME /data
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/figcraft-entrypoint"]
