# syntax=docker/dockerfile:1
# Child image that adds agent CLIs to the Paseo base image.
#
# Defaults to `paseo:src`, a Paseo built from this repo, because the Kiro usage
# source (plugins/kiro-usage-source) ships as a built-in plugin of
# @getpaseo/server and cannot be layered on from here. Build the base first:
#
#   docker build -f docker/base/Dockerfile -t paseo:src .
#
# To go back to the published image — dropping Kiro usage with it:
#
#   docker compose build --build-arg PASEO_IMAGE=ghcr.io/getpaseo/paseo:latest
#
# docker/docker-compose.yml builds this image directly, so `docker compose up -d
# --build` is enough for the normal workflow.

ARG PASEO_IMAGE=paseo:src
FROM ${PASEO_IMAGE}

# Links the published package to its repository on GHCR. Without it the image is
# filed under the account rather than shown on the repo's Packages panel, and
# provenance has to be inferred from which workflow run happened to succeed.
# Defaults to upstream so forks stay mergeable; CI overrides it per repository:
#   --build-arg IMAGE_SOURCE=https://github.com/${{ github.repository }}
ARG IMAGE_SOURCE=https://github.com/getpaseo/paseo
LABEL org.opencontainers.image.source="${IMAGE_SOURCE}"

USER root
# The CLIs below are unpinned so every image ships the newest release, but the
# layer cache would keep the first release ever installed for as long as the
# base image is unchanged. CI passes a new value per run (the run ID); every RUN
# after an ARG sees it, so a new value reinstalls them. Local builds leave it
# empty and keep the cache.
ARG CLI_REFRESH=
# The chown belongs in THIS layer, not a later one. These packages are ~1.4 GB;
# a `chown -R` in a separate RUN rewrites every one of those files into a new
# layer and grows the image by that much, for a metadata change. Setting the
# ownership where the files are created costs nothing.
#
# It is needed because the install runs as root while Paseo runs agents as
# `paseo` (uid 1000), and Claude Code's updater writes into the npm prefix:
# without this, every container built from this image reports that it has no
# write permission there and can never self-update. Nothing after this step
# writes into node_modules, so the ownership survives.
RUN npm install -g \
  @anthropic-ai/claude-code \
  @openai/codex \
  opencode-ai \
  && chown -R paseo:paseo /usr/local/lib/node_modules

# MCP servers that the shared-mcp built-in runs once per container, pinned
# because their flags and HTTP behaviour are what the server definitions were
# written against. Definitions call the installed bins (`playwright-mcp`,
# `context7-mcp`, `mcp-gitlab`) rather than `npx -y <pkg>@<version>`: npx keeps
# an `npm exec` parent of about 165 MB alive next to every server. `npx -y`
# still works for a config that uses it; it fetches into the npm cache as before.
#
# @playwright/mcp is installed but its browsers deliberately are not: it runs
# with --cdp-endpoint against the `browser` service, so it drives that Chromium
# instead of launching its own. That keeps ~500MB of browser binaries out of
# this image and, more importantly, puts the agents and you in the same browser.
#
# Root-owned on purpose: nothing updates these in place, and a version bump is a
# change here. CLI_REFRESH reruns this step too, but the pins hold the versions,
# and the loop fails the build if npm installed anything other than the pin.
RUN set -eux; \
    npm install -g \
      @playwright/mcp@0.0.81 \
      @upstash/context7-mcp@4.0.4 \
      @zereight/mcp-gitlab@2.1.52; \
    for pin in @playwright/mcp@0.0.81 @upstash/context7-mcp@4.0.4 @zereight/mcp-gitlab@2.1.52; do \
      name="${pin%@*}"; want="${pin##*@}"; \
      got="$(node -p "require('/usr/local/lib/node_modules/${name}/package.json').version")"; \
      [ "$got" = "$want" ] || { echo "$name is $got, expected $want" >&2; exit 1; }; \
    done; \
    command -v playwright-mcp context7-mcp mcp-gitlab

# Kiro CLI has no npm package, so it comes from Amazon's release archive.
#
# Two things this has to work around:
#   * Kiro installs to $HOME/.local/bin by default. HOME is /home/paseo, which
#     is a mounted volume at runtime, so a build-time install there would be
#     masked. --global puts the binary in /usr/local/bin instead. Since the
#     installer of 2026-11-05 it is also required: without it the installer
#     refuses a root install into a HOME that root does not own, and it no
#     longer reads Q_INSTALL_GLOBAL.
#   * The aarch64 GNU build needs glibc 2.39; this image is bookworm (2.36).
#     The musl build has no such floor, so arm64 uses that variant.
#
# A global install edits no shell files, so nothing interactive runs.
# One RUN layer keeps the archive out of the image.
ARG TARGETARCH
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) asset="kirocli-x86_64-linux.zip" ;; \
      arm64) asset="kirocli-aarch64-linux-musl.zip" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/kirocli.zip \
      "https://desktop-release.q.us-east-1.amazonaws.com/latest/${asset}"; \
    unzip -q /tmp/kirocli.zip -d /tmp; \
    /tmp/kirocli/install.sh --global; \
    rm -rf /tmp/kirocli.zip /tmp/kirocli; \
    kiro-cli --version

# GitHub CLI, from GitHub's own apt repo, plus jq from Debian, which agents
# reach for on every JSON config, and python3, which the ui-ux-pro-max skill
# from the default-skills built-in runs for its search. Kept after the Kiro
# step so editing this does not invalidate that layer and re-download the
# archive.
RUN set -eux; \
    mkdir -p -m 755 /etc/apt/keyrings; \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh jq python3; \
    rm -rf /var/lib/apt/lists/*; \
    gh --version; \
    jq --version; \
    python3 --version

# FigCraft CLI for design mode (plugins/design): the bridge and agents run `figcraft-cli mcp`.
# Pinned and checked against the release's SHA256SUMS.txt; keep FIGCRAFT_VERSION in step with
# Dockerfile.figcraft (docs/docker.md). It links only against libc, libm and libgcc_s.
ARG FIGCRAFT_VERSION=0.18.1
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/storytold/figcraft/releases/download/v${FIGCRAFT_VERSION}"; \
    app="figcraft-${FIGCRAFT_VERSION}-linux-${arch}.tar.gz"; \
    mkdir /tmp/figcraft; \
    cd /tmp/figcraft; \
    curl -fsSL -o SHA256SUMS.txt "${base}/SHA256SUMS.txt"; \
    curl -fsSL -o "${app}" "${base}/${app}"; \
    grep " ${app}\$" SHA256SUMS.txt > wanted.txt; \
    test "$(wc -l < wanted.txt)" -eq 1; \
    sha256sum -c wanted.txt; \
    tar -xzf "${app}"; \
    install -m 0755 "figcraft-${FIGCRAFT_VERSION}-linux-${arch}/bin/figcraft-cli" \
      /usr/local/bin/figcraft-cli; \
    cd /; \
    rm -rf /tmp/figcraft; \
    figcraft-cli --version

# What a repo's own Playwright suite needs to launch Chromium in this container.
#
# The browser is not here: each repo pins its own Playwright version and fetches
# the matching build with `npx playwright install chromium`, into the home
# volume. That build links against system libraries, and `playwright
# install-deps` needs root, which agents do not have, so the libraries are in
# the image. The list is Playwright's own for Debian 12 (playwright-core's
# nativeDeps.js, `chromium`), with the fonts a page needs to draw text and emoji.
# @playwright/mcp above is unaffected: it still drives the `browser` service.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 \
      libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0 \
      libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxkbcommon0 libxrandr2 \
      libfontconfig1 libfreetype6 fonts-liberation fonts-noto-color-emoji; \
    rm -rf /var/lib/apt/lists/*

# GitHub's SSH host keys, system-wide.
#
# Without this, the first `git clone git@github.com:...` in a fresh container
# fails with "Host key verification failed" — a per-user known_hosts starts
# empty, and every new instance gets one. OpenSSH also ignores a known_hosts it
# does not own, so a clone that runs as root fails even when the paseo user has
# already trusted the host.
#
# Keys come from GitHub's own API over TLS so they stay current through a key
# rotation, and the ED25519 fingerprint is pinned so a substituted key fails the
# build instead of being trusted silently. Fingerprint published at
# https://docs.github.com/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints
RUN <<'SCRIPT'
set -eux
curl -fsSL https://api.github.com/meta -o /tmp/gh-meta.json
node -e '
const meta = require("/tmp/gh-meta.json");
const keys = meta.ssh_keys;
if (!Array.isArray(keys) || keys.length === 0) throw new Error("no ssh_keys in api.github.com/meta");
require("node:fs").writeFileSync(
  "/etc/ssh/ssh_known_hosts",
  keys.map((k) => "github.com " + k).join("\n") + "\n",
);
'
chmod 644 /etc/ssh/ssh_known_hosts
rm -f /tmp/gh-meta.json
ssh-keygen -lf /etc/ssh/ssh_known_hosts | grep -q "SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU"
SCRIPT

# SSH configuration for an optional private Git server, applied at start from
# the environment. See docker/docker-compose.vpn.yml.
COPY agents/rootfs/ /
RUN set -eux; \
    sed -i 's/\r$//' /usr/local/bin/paseo-agents-ssh-setup; \
    chmod +x /usr/local/bin/paseo-agents-ssh-setup; \
    bash -n /usr/local/bin/paseo-agents-ssh-setup

# The other half of the npm-prefix fix: npm needs write on /usr/local/bin to
# replace the `claude` symlink it points at the package.
#
# Chowned as a directory and NOT recursively, for two reasons. It costs one
# inode instead of copying the ~1.1 GB of Kiro binaries that live here into a
# new layer, and the binaries other tools installed keep root ownership. The
# directory has no sticky bit, so a self-updater that replaces a file — the
# usual download-then-rename — still works; only one that rewrites a root-owned
# binary in place would not.
#
# Last, after every root-owned install above: npm, the Kiro archive and the
# rootfs copy. The entrypoint generated below lands here afterwards and stays
# root-owned, which is correct — root runs it.
RUN chown paseo:paseo /usr/local/bin

# Paseo launches agents as the non-root `paseo` user (uid 1000), but /home/paseo
# and /workspace are mounted volumes that survive rebuilds. Anything left
# root-owned in them — most easily by a bare `docker exec`, which defaults to
# root, or by Docker creating an empty bind-mount source — breaks agents in ways
# that give no useful error: Kiro exits silently (code 0, no stderr) when
# session/new cannot write .kiro/sessions, Codex fails to open its sqlite state
# under .codex, and a root-owned /workspace refuses `mkdir` with EACCES.
#
# The base entrypoint chowns a fixed set of top-level dirs only when they are
# themselves root-owned, so nested contamination survives. Repair both trees on
# every start instead. The find only writes when something is actually
# mis-owned, so the normal path is a read-only walk.
RUN <<'SCRIPT'
set -eux
# A Windows checkout with core.autocrlf=true rewrites the base image's
# entrypoint to CRLF, so its `#!/usr/bin/env bash` shebang picks up a trailing
# carriage return and the container dies in a restart loop (exit 127). Strip
# them with node so there is no shell escaping to get wrong. This is a no-op
# for an image built from a Linux checkout.
node -e "const f='/usr/local/bin/paseo-docker-entrypoint';const fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').split(String.fromCharCode(13)).join(''))"
bash -n /usr/local/bin/paseo-docker-entrypoint
cat > /usr/local/bin/paseo-agents-entrypoint <<'ENTRY'
#!/bin/sh
set -e
if [ "$(id -u)" = "0" ]; then
  for tree in /home/paseo /workspace; do
    [ -d "$tree" ] || continue
    count=$(find "$tree" \( ! -user paseo -o ! -group paseo \) -print 2>/dev/null | wc -l)
    if [ "$count" -gt 0 ]; then
      echo "[agents] repairing ownership on $count path(s) under $tree" >&2
      find "$tree" \( ! -user paseo -o ! -group paseo \) -exec chown paseo:paseo {} + 2>/dev/null || true
    fi
  done
fi
/usr/local/bin/paseo-agents-ssh-setup || echo "[agents] WARNING: paseo-agents-ssh-setup failed; continuing without internal SSH config" >&2
# The stack files cannot omit these when they are unset: `${GIT_AUTHOR_NAME:-}`
# defines the variable as an empty string, and git rejects an empty ident with
# "empty ident name" instead of falling back to git config -- so an unconfigured
# author breaks every commit in the container. Drop only the empties, before
# exec so every descendant inherits the result. A configured identity still
# reaches the agent untouched, which is what keeps per-container attribution
# working on a shared /workspace.
for var in GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
  eval "value=\${$var-}"
  [ -n "$value" ] || unset "$var"
done
unset var value
exec /usr/local/bin/paseo-docker-entrypoint "$@"
ENTRY
chmod +x /usr/local/bin/paseo-agents-entrypoint
SCRIPT

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/paseo-agents-entrypoint"]

# Leave the image user as root. The base entrypoint prepares mounted volumes,
# then drops the daemon and launched agents to the non-root `paseo` user.
