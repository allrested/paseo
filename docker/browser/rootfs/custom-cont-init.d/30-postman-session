#!/usr/bin/with-contenv bash
# Put Postman in front of the user on an already-provisioned session.
#
# init-selkies-config copies /defaults/menu*.xml into $HOME/.config only when
# the file is missing, and restores menu.xml from menu.xml.bak on every start.
# An existing /config volume therefore never sees a new default, and editing
# menu.xml alone is undone at the next restart - so patch the backup too, and
# keep both edits idempotent.

if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
  CONF_DIR="${HOME}/.config/labwc"
else
  CONF_DIR="${HOME}/.config/openbox"
fi

LAUNCH="/usr/local/bin/wrapped-postman"
ENTRY="<item label=\"Postman\"><action name=\"Execute\"><command>${LAUNCH}</command></action></item>"

for menu in "${CONF_DIR}/menu.xml" "${CONF_DIR}/menu.xml.bak"; do
  [[ -f "${menu}" ]] || continue
  grep -q "wrapped-postman" "${menu}" && continue
  sed -i "s|</menu>|${ENTRY}\n</menu>|" "${menu}"
  chown abc:abc "${menu}"
  echo "[postman] menu entry added to ${menu}"
done

# Start it with the session unless asked not to. The entry has to go before the
# line that starts the browser, because that line is what holds the session
# open - anything after it only runs once the browser exits.
if [[ "${POSTMAN_AUTOSTART:-true}" == "true" ]]; then
  autostart="${CONF_DIR}/autostart"
  if [[ -f "${autostart}" ]] && ! grep -q "wrapped-postman" "${autostart}"; then
    # The base image locks this file to root:abc 550 when RESTART_APP is set.
    owner="$(stat -c '%U:%G' "${autostart}")"
    mode="$(stat -c '%a' "${autostart}")"
    chmod u+w "${autostart}"
    sed -i "/^wrapped-chromium/i /usr/local/bin/postman-session &" "${autostart}"
    chown "${owner}" "${autostart}"
    chmod "${mode}" "${autostart}"
    echo "[postman] autostart entry added to ${autostart}"
  fi
fi
